# ForwardX 端口转发管理面板 - 环境变量配置
# 复制此文件为 .env 并修改对应值

# ==================== 数据库配置 ====================
# SQLite 数据库文件路径（Docker 部署时挂载到 /data 目录）
SQLITE_PATH=/data/forwardx.db

# ==================== 安全配置 ====================
# JWT 签名密钥（生产环境务必修改为随机字符串）
JWT_SECRET=change-me-to-a-random-string

# ==================== 应用配置 ====================
# 运行环境
NODE_ENV=production

# 监听端口
PORT=9810

# Docker 部署镜像。默认使用 GitHub Packages 预编译镜像，不需要在服务器上本地构建。
FORWARDX_IMAGE=ghcr.io/deradream/forwardx:latest

# 旧版 Agent/FXP 加密协议时间自动校准（不会修改宿主机或 Docker 系统时间）
# FORWARDX_PANEL_TIME_SYNC=true
# 可选：使用逗号分隔的可信 HTTPS 时间来源覆盖默认来源
# FORWARDX_PANEL_TIME_SOURCES=https://www.cloudflare.com/cdn-cgi/trace,https://github.com/,https://www.baidu.com/
# 仅有一个可信时间来源时才建议开启
# FORWARDX_PANEL_TIME_ALLOW_SINGLE_SOURCE=false

# ==================== 网络画像（可选） ====================
# AbuseIPDB 仅使用官方 API；需要 API Key。未配置时网络画像会直接隐藏 AbuseIPDB，不再经 check.place 代查。
# ABUSEIPDB_API_KEY=replace-with-your-abuseipdb-api-key

# MaxMind 的“使用类型”来自官方 GeoIP Insights（traits.user_type / connection_type），
# MaxMind 免费/基础地理库并不提供这类类型字段；配置后 IP 类型属性会显示 MaxMind。
# MAXMIND_ACCOUNT_ID=replace-with-your-maxmind-account-id
# MAXMIND_LICENSE_KEY=replace-with-your-maxmind-license-key

# DB-IP 的 usageType（hosting / corporate / consumer / reserved）属于 Core/Extended 数据。
# 未配置 Key 时会尝试官方 Demo；Demo 有每日配额，耗尽后列会提示需要 API Key。
# DBIP_API_KEY=replace-with-your-dbip-api-key

# ==================== Telegram 机器人（可选） ====================
# 从 @BotFather 获取 Bot Token。也可以登录后台后在「系统设置」中填写。
# TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token
# 是否启用长轮询。默认 true，不需要配置 webhook。
# TELEGRAM_BOT_POLLING=true

# 管理员邮箱和密码在首次访问面板的初始化向导中创建。
# 为避免环境变量意外覆盖生产凭据，面板不支持通过 ADMIN_PASSWORD 重置管理员密码。
