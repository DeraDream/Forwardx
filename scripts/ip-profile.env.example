# Copy to /etc/forwardx/ip-profile.env and set file mode 600.
# Leave an item empty to mark that provider as unavailable.
FORWARDX_IPREGISTRY_KEY=
FORWARDX_IPAPI_KEY=
FORWARDX_IP2LOCATION_KEY=
FORWARDX_ABUSEIPDB_KEY=
FORWARDX_SCAMALYTICS_KEY=
FORWARDX_DBIP_KEY=
FORWARDX_IPDATA_KEY=
FORWARDX_IPQS_KEY=
# Optional: ProxyCheck also has a limited keyless mode.
FORWARDX_PROXYCHECK_KEY=
